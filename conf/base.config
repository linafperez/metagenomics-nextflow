process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    errorStrategy = { task.exitStatus in 130..145 ? 'retry' : 'terminate' }
    maxRetries    = 1
}

timeline {
    enabled = true
    file    = "${params.telemetryDir ?: "${params.outdir}/pipeline_info"}/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file    = "${params.telemetryDir ?: "${params.outdir}/pipeline_info"}/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.telemetryDir ?: "${params.outdir}/pipeline_info"}/execution_trace.tsv"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,error_action,container,cpus,memory,time,accelerator,accelerator_type,queue,hostname,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,vol_ctxt,inv_ctxt,workdir'
    raw     = true
    overwrite = true
}

dag {
    enabled = true
    file    = "${params.telemetryDir ?: "${params.outdir}/pipeline_info"}/pipeline_dag.html"
    overwrite = true
}
