process {
    withName: CHECK_SAMPLESHEET {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode]
    }

    withName: FASTQC_RAW {
        ext.prefix = { "${meta.id}_raw" }
        publishDir = [path: { "${params.outdir}/01_quality_control_and_filtering/fastqc/raw/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*_fastqc.{html,zip}']
    }

    withName: FASTP {
        ext.prefix = { meta.id }
        ext.args = [
            '--qualified_quality_phred 30',
            '--length_required 30',
            '--detect_adapter_for_pe',
            '--trim_poly_g',
            '--trim_poly_x',
            '--cut_right',
            '--cut_right_window_size 4',
            '--cut_right_mean_quality 30',
            '--thread 6'
        ].join(' ')
        publishDir = [
            [path: { "${params.outdir}/01_quality_control_and_filtering/fastp/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.fastp.{html,json}'],
            [path: { "${params.outdir}/01_quality_control_and_filtering/fastp/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*_trimmed_*.fastq', enabled: params.save_clean_reads]
        ]
    }

    withName: FASTQC_CLEAN {
        ext.prefix = { "${meta.id}_clean" }
        publishDir = [path: { "${params.outdir}/01_quality_control_and_filtering/fastqc/clean/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*_fastqc.{html,zip}']
    }

    withName: BOWTIE2_HOST_REMOVAL {
        ext.prefix = { meta.id }
        ext.args = '--very-sensitive-local --phred33'
        publishDir = [
            [path: { "${params.outdir}/01_quality_control_and_filtering/host_removal/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.bowtie2.log'],
            [path: { "${params.outdir}/01_quality_control_and_filtering/host_removal/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*_nonhost_*.fastq.gz', enabled: params.save_host_removed_reads]
        ]
    }

    withName: MEGAHIT {
        publishDir = [path: { "${params.outdir}/02_mag_construction/megahit/assembly" }, mode: params.publish_dir_mode, pattern: '*.{contigs.fa,megahit.log}']
    }

    withName: SPADES {
        publishDir = [path: { "${params.outdir}/02_mag_construction/spades/assembly" }, mode: params.publish_dir_mode, pattern: '*.{contigs.fa,scaffolds.fa,assembly.gfa,spades.log,spades.params.txt}']
    }

    withName: 'METAQUAST_MEGAHIT|METAQUAST_SPADES' {
        publishDir = [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/assembly/metaquast" }, mode: params.publish_dir_mode, pattern: '*.{metaquast.report.tsv,metaquast.report.html,metaquast.log}']
    }

    withName: FILTER_CONTIGS {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/contigs" }, mode: params.publish_dir_mode, pattern: '*.contig_filter.tsv'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/contigs" }, mode: params.publish_dir_mode, pattern: '*.filtered.fa', enabled: params.save_intermediates]
        ]
    }

    withName: COVERM_CONTIG {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/coverage" }, mode: params.publish_dir_mode, pattern: '*.{metabat_depth.tsv,vamb_abundance.tsv,coverm.log}'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/coverage" }, mode: params.publish_dir_mode, pattern: 'bam/*.bam', enabled: params.save_bam]
        ]
    }

    withName: COMEBIN {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/comebin" }, mode: params.publish_dir_mode, pattern: '*.bins/*.{fa,fna,fasta}'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/comebin" }, mode: params.publish_dir_mode, pattern: '*.{contigs2bin.tsv,comebin.log}'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/comebin/native" }, mode: params.publish_dir_mode, pattern: '*.comebin', enabled: params.save_intermediates]
        ]
    }

    withName: METABAT2 {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/metabat2" }, mode: params.publish_dir_mode, pattern: '*.bins/*.{fa,fna,fasta}'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/metabat2" }, mode: params.publish_dir_mode, pattern: '*.{contigs2bin.tsv,metabat2.log}']
        ]
    }

    withName: SEMIBIN2 {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/semibin2" }, mode: params.publish_dir_mode, pattern: '*.bins/*.{fa,fna,fasta}'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/semibin2" }, mode: params.publish_dir_mode, pattern: '*.{contigs2bin.tsv,semibin2.log}'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/semibin2/native" }, mode: params.publish_dir_mode, pattern: '*.semibin2', enabled: params.save_intermediates]
        ]
    }

    withName: VAMB {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/vamb" }, mode: params.publish_dir_mode, pattern: '*.bins/*.{fa,fna,fasta}'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/vamb" }, mode: params.publish_dir_mode, pattern: '*.{contigs2bin.tsv,vamb.log}'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/vamb/native" }, mode: params.publish_dir_mode, pattern: '*.vamb', enabled: params.save_intermediates]
        ]
    }

    withName: DASTOOL {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/dastool" }, mode: params.publish_dir_mode, pattern: '*_DASTool_bins/*.{fa,fna,fasta}'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/binning/dastool" }, mode: params.publish_dir_mode, pattern: '*{_DASTool_summary.tsv,_DASTool_contigs2bin.tsv,_allBins.eval,_DASTool.log,_proteins.faa}']
        ]
    }

    withName: CHECKM2_RAW {
        publishDir = [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/refinement/raw/checkm2" }, mode: params.publish_dir_mode, pattern: '*.{checkm2.quality_report.tsv,checkm2.log}']
    }

    withName: GUNC_RAW {
        publishDir = [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/refinement/raw/gunc" }, mode: params.publish_dir_mode, pattern: '*.{gunc.summary.tsv,gunc.log}']
    }

    withName: SELECT_HIGH_QUALITY_MAGS {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/refinement/high_quality" }, mode: params.publish_dir_mode, pattern: 'hq_mags/*.fa'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/refinement/high_quality" }, mode: params.publish_dir_mode, pattern: '{hq_mags.tsv,genomeInfo.csv}']
        ]
    }

    withName: DREP_ANI_99 {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/refinement/drep_99" }, mode: params.publish_dir_mode, pattern: '*.representatives/*.fa'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/refinement/drep_99" }, mode: params.publish_dir_mode, pattern: '*.{clusters.csv,drep.log}']
        ]
    }

    withName: DREP_SPECIES_95 {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/refinement/species_95" }, mode: params.publish_dir_mode, pattern: '*.representatives/*.fa'],
            [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/refinement/species_95" }, mode: params.publish_dir_mode, pattern: '*.{clusters.csv,drep.log}']
        ]
    }

    withName: CHECKM2_CLEAN {
        publishDir = [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/refinement/clean/checkm2" }, mode: params.publish_dir_mode, pattern: '*.{checkm2.quality_report.tsv,checkm2.log}']
    }

    withName: GUNC_CLEAN {
        publishDir = [path: { "${params.outdir}/02_mag_construction/${meta.assembler}/refinement/clean/gunc" }, mode: params.publish_dir_mode, pattern: '*.{gunc.summary.tsv,gunc.log}']
    }

    withName: COMBINE_MAG_CATALOGS {
        publishDir = [path: { "${params.outdir}/02_mag_construction/final_catalog/combined_input" }, mode: params.publish_dir_mode, pattern: '{combined_catalog.provenance.tsv,combined_catalog.quality.tsv,combined_catalog.genomeInfo.csv}']
    }

    withName: DREP_FINAL_99 {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/final_catalog/drep_99" }, mode: params.publish_dir_mode, pattern: '*.representatives/*.fa'],
            [path: { "${params.outdir}/02_mag_construction/final_catalog/drep_99" }, mode: params.publish_dir_mode, pattern: '*.{clusters.csv,drep.log}']
        ]
    }

    withName: DREP_FINAL_SPECIES_95 {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/final_catalog/species_95" }, mode: params.publish_dir_mode, pattern: '*.representatives/*.fa'],
            [path: { "${params.outdir}/02_mag_construction/final_catalog/species_95" }, mode: params.publish_dir_mode, pattern: '*.{clusters.csv,drep.log}']
        ]
    }

    withName: FINALIZE_MAG_CATALOG {
        publishDir = [
            [path: { "${params.outdir}/02_mag_construction/final_catalog" }, mode: params.publish_dir_mode, pattern: 'final_catalog/*.fa'],
            [path: { "${params.outdir}/02_mag_construction/final_catalog" }, mode: params.publish_dir_mode, pattern: 'final_catalog.{provenance,quality}.tsv']
        ]
    }

    withName: CHECKM2_FINAL {
        publishDir = [path: { "${params.outdir}/02_mag_construction/final_catalog/evaluation/checkm2" }, mode: params.publish_dir_mode, pattern: '*.{checkm2.quality_report.tsv,checkm2.log}']
    }

    withName: GUNC_FINAL {
        publishDir = [path: { "${params.outdir}/02_mag_construction/final_catalog/evaluation/gunc" }, mode: params.publish_dir_mode, pattern: '*.{gunc.summary.tsv,gunc.log}']
    }

    withName: GTDBTK_CLASSIFY {
        publishDir = [path: { "${params.outdir}/03_taxonomic_classification_and_phylogenomics/gtdbtk" }, mode: params.publish_dir_mode, pattern: '*.{gtdbtk,gtdbtk.bac120.summary.tsv,gtdbtk.ar53.summary.tsv,gtdbtk.log}']
    }

    withName: PHYLOPHLAN {
        ext.container = params.phylophlan_container ?: null
        publishDir = [path: { "${params.outdir}/03_taxonomic_classification_and_phylogenomics/phylophlan" }, mode: params.publish_dir_mode, pattern: '*.{phylophlan.tree.nwk,phylophlan.alignment.fasta,phylophlan,phylophlan.log}']
    }

    withName: GENEMARKS2 {
        publishDir = [path: { "${params.outdir}/04_gene_prediction_and_functional_annotation/genemarks2/${meta.mag_id}" }, mode: params.publish_dir_mode, pattern: '*.{proteins.faa,cds.fna,genes.gff,genemarks2.log}']
    }

    withName: EGGNOGMAPPER {
        publishDir = [path: { "${params.outdir}/04_gene_prediction_and_functional_annotation/eggnog_mapper/${meta.mag_id}" }, mode: params.publish_dir_mode, pattern: '*.{emapper.annotations,emapper.seed_orthologs,emapper.orthologs,eggnogmapper.log}']
    }

    withName: INTERPROSCAN {
        publishDir = [path: { "${params.outdir}/04_gene_prediction_and_functional_annotation/interproscan/${meta.mag_id}" }, mode: params.publish_dir_mode, pattern: '*.{interproscan.tsv,interproscan.gff3,interproscan.json,interproscan.log}']
    }

    withName: INTEGRATE_ANNOTATIONS {
        publishDir = [path: { "${params.outdir}/04_gene_prediction_and_functional_annotation/integrated/${meta.mag_id}" }, mode: params.publish_dir_mode, pattern: '*.{functional_annotations.tsv,functional_annotations.summary.json,annotation_integration.log}']
    }

    withName: COVERM_MAG_ABUNDANCE {
        publishDir = [path: { "${params.outdir}/05_mag_abundance_estimation" }, mode: params.publish_dir_mode, pattern: '*.{mag_abundance.tsv,coverm.log}']
    }

    withName: NORMALIZE_ABUNDANCE {
        publishDir = [path: { "${params.outdir}/05_mag_abundance_estimation" }, mode: params.publish_dir_mode, pattern: '*.mag_abundance.long.tsv']
    }

    withName: MULTIQC {
        publishDir = [path: { "${params.outdir}/06_global_processing_evaluation" }, mode: params.publish_dir_mode, pattern: '*.{multiqc.html,multiqc_data,multiqc.log}']
    }

    withName: COLLECT_VERSIONS {
        publishDir = [path: { "${params.outdir}/pipeline_info" }, mode: params.publish_dir_mode]
    }
}
