process {
    withName: 'METAGENOMICS:CHECK_SAMPLESHEET' {
        cpus   = 1
        memory = 1.GB
    }

    withName: 'METAGENOMICS:QUALITY_CONTROL_AND_FILTERING:FASTQC_(RAW|CLEAN)' {
        cpus   = params.stub_run ? 1 : 4
        memory = params.stub_run ? 1.GB : 19.GB
    }

    // The legacy job allocated 16 CPUs, while fastp itself received 6 threads.
    withName: 'METAGENOMICS:QUALITY_CONTROL_AND_FILTERING:FASTP' {
        cpus   = params.stub_run ? 1 : 16
        memory = params.stub_run ? 1.GB : 19.GB
    }

    withName: 'METAGENOMICS:QUALITY_CONTROL_AND_FILTERING:BOWTIE2_HOST_REMOVAL' {
        cpus   = params.stub_run ? 1 : 24
        memory = params.stub_run ? 1.GB : 19.GB
    }
}
