params.stub_run = true

process {
    maxForks = 4
    cpus = 1
    memory = 1.GB
    time = 10.m
    container = 'python:3.12.11-slim-bookworm'
    conda = 'conda-forge::python=3.12'

    withName: '.*' {
        cpus = 1
        memory = 1.GB
        time = 10.m
        container = 'python:3.12.11-slim-bookworm'
        conda = 'conda-forge::python=3.12'
    }
}
