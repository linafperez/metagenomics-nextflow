params.enableGpu = true

process {
    withName: 'COMEBIN|SEMIBIN2|VAMB' {
        accelerator = params.gpuAccelerators as int
        containerOptions = params.gpuContainerOptions ?: null

        // Nextflow's generic accelerator request does not invent a SLURM site
        // policy.  The launcher requires an explicit GRES value on SLURM and
        // combines it with the ordinary account/QoS options here.
        clusterOptions = [
            params.slurm_account ? "--account=${params.slurm_account}" : null,
            params.slurm_qos ? "--qos=${params.slurm_qos}" : null,
            params.slurm_cluster_options ?: null,
            params.slurmGpuGres ? "--gres=${params.slurmGpuGres}" : null
        ].findAll { option -> option }.join(' ') ?: null
    }

    withName: COMEBIN {
        container = params.comebinGpuContainer
        conda = "${projectDir}/modules/core/comebin/environment-gpu.yml"
    }

    withName: SEMIBIN2 {
        container = params.semibinGpuContainer
        conda = "${projectDir}/modules/core/semibin2/environment-gpu.yml"
    }

    withName: VAMB {
        container = params.vambGpuContainer
        conda = "${projectDir}/modules/core/vamb/environment-gpu.yml"
    }
}
