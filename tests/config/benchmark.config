params {
    benchmark_assembler = null
    benchmark_binner = null
    benchmark_publish_mode = 'copy'
}

process {
    withName: 'BENCHMARK:.*' {
        publishDir = [
            path: {
                def process_path = task.process.replace(':', '/')
                "${params.outdir}/native/${process_path}"
            },
            mode: params.benchmark_publish_mode,
            overwrite: true,
            saveAs: { filename ->
                if (!params.save_intermediates && filename ==~ /.*\.(bam|bai)$/) {
                    return null
                }
                filename
            }
        ]
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,cpus,memory,peak_rss,peak_vmem,rchar,wchar,attempt'
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
